# =====================================================================
# digital_twin_bot — production environment (copy to deploy/.env)
# =====================================================================

# --- Telegram ---
BOT_TOKEN=             # get from @BotFather
ADMIN_TELEGRAM_IDS=    # comma-separated Telegram user IDs with admin rights
ALLOWED_TELEGRAM_IDS=  # closed-test allowlist (empty = open to everyone)

# --- Database ---
POSTGRES_USER=bot
POSTGRES_PASSWORD=  # use a strong random password
POSTGRES_DB=digital_twin

# --- LLM (local llama.cpp) ---
# Filename under ./data/models/ (relative to the repo root)
LLM_MODEL_FILE=Qwen3-4B-Q4_K_M.gguf
LLM_MODEL=qwen3-4b
LLM_TIMEOUT_SECONDS=300
# Qwen3 non-think recipe (official): temp 0.7, top_p 0.8, top_k 20, min_p 0.
# qa_pipeline.py overrides these for factual answers (temp=0.1, top_p=0.9,
# top_k=40, repeat_penalty=1.1) — these env values only apply to other paths.
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_REPEAT_PENALTY=1.05
# 220 tokens fits the new free-form 2-5 sentence answer; raise if you need
# longer explanations. Source of truth = src/config.py:LLM_MAX_TOKENS.
LLM_MAX_TOKENS=220
# Sized for a 4 vCPU / 8 GB VPS, CPU-only.
LLAMA_CTX_SIZE=4096
LLAMA_THREADS=4
LLAMA_PARALLEL=1
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=512

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3

# --- Health probe HTTP ---
HEALTH_LISTEN=0.0.0.0
HEALTH_PORT=8081

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
