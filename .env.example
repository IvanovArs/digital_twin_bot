# =====================================================================
# digital_twin_bot — environment variables (copy to .env and fill in)
# Do NOT commit .env (it is gitignored).
# =====================================================================

# --- Telegram ---
# Get a token from @BotFather. Never share it, never commit .env.
BOT_TOKEN=
# Comma-separated Telegram user IDs that get admin rights in the bot.
ADMIN_TELEGRAM_IDS=
# Comma-separated Telegram user IDs allowed to use the bot at all (closed-test allowlist).
# Empty = open to everyone. Example for closed testing: ALLOWED_TELEGRAM_IDS=1940359844
ALLOWED_TELEGRAM_IDS=

# --- Health probe HTTP (always on) ---
# /healthz (liveness) + /readyz (readiness). Used by docker / k8s.
HEALTH_LISTEN=0.0.0.0
HEALTH_PORT=8081

# --- Database ---
# Default (dev): SQLite lives in ./data/dev.db — no service to run.
# Override for Postgres:
#   DB_URL=postgresql+asyncpg://user:pass@host:5432/digital_twin
# DB_URL=sqlite+aiosqlite:///./data/dev.db

# --- LLM (local llama.cpp, OpenAI-compatible API) ---
# Dev (llama-server.exe on Windows): http://127.0.0.1:8080/v1
# Prod (docker compose):             http://llama-cpp:8080/v1
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://127.0.0.1:8089/v1
LLM_API_KEY=
LLM_MODEL=qwen
LLM_TIMEOUT_SECONDS=300
# Qwen3 non-think recipe (official): temp 0.7, top_p 0.8, top_k 20, min_p 0
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_REPEAT_PENALTY=1.05
LLM_MAX_TOKENS=600

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3

# --- RAG pipeline ---
CHUNK_SIZE=650
CHUNK_OVERLAP=130
RETRIEVER_TOP_K=6
# Confidence margin between top-1 and top-2 subjects (0..1). Below = ambiguous.
ROUTER_CONFIDENCE_MARGIN=0.08

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Paths (relative to project root; override only for non-standard layouts) ---
BOOKS_DIR=data/books
INDEX_DIR=data/index
MODELS_DIR=data/models
COURSES_YAML=courses.yaml
